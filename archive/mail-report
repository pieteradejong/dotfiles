#!/usr/bin/env python3
"""mail-report — send stdin as a plain-text email, over Gmail SMTP with the
credentials from the macOS Keychain.

Usage:  mail-report --subject SUBJECT [--to ADDR] < body     send the body
        mail-report --test                                   one-line probe mail to yourself
        mail-report --dry-run --subject SUBJECT < body       print the message; send nothing
        mail-report -h | --help

The maintenance jobs (bin/weekly-disk-cleanup.sh, scripts/mac-maintenance.sh)
pipe their run into this at the end, so the result lands in the inbox every
time they run. Nothing personal lives in this repo: the sender address and the
password are one Keychain item, created once by hand (docs/maintenance.md
§ Email reports):

    security add-generic-password -U -s dotfiles-mail-report -a <gmail address> -w

  service   dotfiles-mail-report  (override: MAIL_REPORT_SERVICE)
  account   the Gmail address — sender, and recipient unless --to or MAIL_REPORT_TO
  password  a Gmail App Password (needs 2-step verification on the account)

Env:  MAIL_REPORT_SMTP     host:port, default smtp.gmail.com:465 (implicit TLS)
      MAIL_REPORT_TO       default recipient
      MAIL_REPORT_SERVICE  Keychain service name (tests point it at a fake)

Exit: 0 sent · 1 send failed (network, auth) · 2 bad usage ·
      3 not configured (no `security` on PATH, or no Keychain item).
Callers treat 1 and 3 as a warning: a missing mailbox never fails a job.
The password is never printed, not even on failure.
"""

import os
import re
import smtplib
import socket
import ssl
import subprocess
import sys
from email.message import EmailMessage
from email.utils import formatdate

SERVICE = os.environ.get("MAIL_REPORT_SERVICE", "dotfiles-mail-report")
SMTP = os.environ.get("MAIL_REPORT_SMTP", "smtp.gmail.com:465")
TIMEOUT = 30

EXIT_SENT, EXIT_SEND_FAILED, EXIT_USAGE, EXIT_UNCONFIGURED = 0, 1, 2, 3


def usage(code):
    out = sys.stdout if code == 0 else sys.stderr
    out.write(__doc__)
    return code


def keychain():
    """(address, password) from the Keychain item, or None when unconfigured."""
    try:
        meta = subprocess.run(
            ["security", "find-generic-password", "-s", SERVICE],
            capture_output=True, text=True, timeout=TIMEOUT, check=False,
        )
        if meta.returncode != 0:
            return None
        pw = subprocess.run(
            ["security", "find-generic-password", "-s", SERVICE, "-w"],
            capture_output=True, text=True, timeout=TIMEOUT, check=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    if pw.returncode != 0:
        return None
    # The account attribute is printed as   "acct"<blob>="user@host"
    m = re.search(r'"acct"<blob>="([^"]*)"', meta.stdout + meta.stderr)
    if not m or not m.group(1):
        return None
    return m.group(1), pw.stdout.rstrip("\n")


def compose(sender, to, subject, body):
    msg = EmailMessage()
    msg["From"] = sender
    msg["To"] = to
    msg["Subject"] = subject
    msg["Date"] = formatdate(localtime=True)
    msg["X-Mailer"] = "dotfiles mail-report"
    msg.set_content(body if body.strip() else "(no output)\n")
    return msg


def send(msg, sender, password):
    host, _, port = SMTP.partition(":")
    port = int(port) if port else 465
    with smtplib.SMTP_SSL(host, port, timeout=TIMEOUT, context=ssl.create_default_context()) as s:
        s.login(sender, password)
        s.send_message(msg)


def main(argv):
    subject = to = None
    dry_run = test = False
    args = list(argv)
    while args:
        a = args.pop(0)
        if a in ("-h", "--help"):
            return usage(0)
        if a == "--subject" and args:
            subject = args.pop(0)
        elif a == "--to" and args:
            to = args.pop(0)
        elif a == "--dry-run":
            dry_run = True
        elif a == "--test":
            test = True
        else:
            sys.stderr.write(f"mail-report: unknown or incomplete option: {a}\n")
            return usage(EXIT_USAGE)

    if test:
        subject = subject or f"mail-report test from {socket.gethostname().split('.')[0]}"
        body = "mail-report is configured; the maintenance jobs can mail their results.\n"
    elif subject is None:
        sys.stderr.write("mail-report: --subject is required\n")
        return usage(EXIT_USAGE)
    else:
        body = sys.stdin.read()

    creds = keychain()
    if creds is None:
        sys.stderr.write(
            f"mail-report: not configured — no Keychain item for service {SERVICE!r} "
            "(see mail-report --help)\n"
        )
        return EXIT_UNCONFIGURED
    sender, password = creds
    to = to or os.environ.get("MAIL_REPORT_TO") or sender
    msg = compose(sender, to, subject, body)

    if dry_run:
        sys.stdout.write(msg.as_string())
        return EXIT_SENT
    try:
        send(msg, sender, password)
    except (smtplib.SMTPException, OSError) as e:
        # str(e) on an SMTP error carries the server's reply, never the credentials.
        sys.stderr.write(f"mail-report: send failed via {SMTP}: {type(e).__name__}: {e}\n")
        return EXIT_SEND_FAILED
    sys.stdout.write(f"mail-report: sent {subject!r} to {to}\n")
    return EXIT_SENT


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
