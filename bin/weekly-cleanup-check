#!/usr/bin/env bash
#
# weekly-cleanup-check — did a weekly-disk-cleanup.sh run do its job?
#
# Usage: weekly-cleanup-check [--run FILE] [--max-age-days N]
#
#   (no args)          check the last run in ~/.weekly-disk-cleanup.log, and
#                      that it is recent: a log older than --max-age-days means
#                      the launchd job is not running.
#   --run FILE         check one run's captured output instead (the weekly
#                      script passes its own at the end of every real run). No
#                      age check.
#   --max-age-days N   default 8 (a weekly job, plus a day of slack).
#
# Checks, one "ok:" or "PROBLEM:" line each, then "Self-check: OK" or
# "Self-check: N problem(s)":
#   - every step heading in weekly-disk-cleanup.sh appears in the run, read from
#     the script itself so a new step is covered without editing this file;
#   - no error lines (command not found, permission errors, lsof or Docker
#     daemon errors, a failed colima start/stop);
#   - the summary lines of the npx, Library-caches and overall steps;
#   - a Colima the run started was stopped again.
#
# Env:  CLEANUP_SCRIPT  the script whose headings are expected
#                       (default: weekly-disk-cleanup.sh beside this file)
#       LOG_FILE        default ~/.weekly-disk-cleanup.log
#
# Exit: 0 all ok, 1 a problem found, 2 bad usage.

set -u

RUN_FILE=""
MAX_AGE_DAYS=8
while [ $# -gt 0 ]; do
  case "$1" in
    --run) RUN_FILE="${2:-}"; shift 2 || { echo "usage: weekly-cleanup-check [--run FILE] [--max-age-days N]" >&2; exit 2; } ;;
    --max-age-days) MAX_AGE_DAYS="${2:-}"; shift 2 || { echo "usage: weekly-cleanup-check [--run FILE] [--max-age-days N]" >&2; exit 2; } ;;
    -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "usage: weekly-cleanup-check [--run FILE] [--max-age-days N]" >&2; exit 2 ;;
  esac
done
case "$MAX_AGE_DAYS" in ''|*[!0-9]*) echo "usage: --max-age-days takes a whole number" >&2; exit 2 ;; esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLEANUP_SCRIPT="${CLEANUP_SCRIPT:-$SCRIPT_DIR/weekly-disk-cleanup.sh}"
LOG_FILE="${LOG_FILE:-$HOME/.weekly-disk-cleanup.log}"

problems=0
ok()      { echo "ok: $*"; }
problem() { echo "PROBLEM: $*"; problems=$((problems + 1)); }

echo "--- Self-check ---"
RUN="$(mktemp "${TMPDIR:-/tmp}/weekly-cleanup-check.XXXXXX")"
trap 'rm -f "$RUN"' EXIT

if [ -n "$RUN_FILE" ]; then
  if [ -r "$RUN_FILE" ]; then cp "$RUN_FILE" "$RUN"; else problem "run file not readable: $RUN_FILE"; fi
elif [ ! -r "$LOG_FILE" ]; then
  problem "no log at $LOG_FILE: the weekly cleanup has never run"
else
  # The last run starts at the last "  Weekly disk cleanup - <date>" line.
  start="$(grep -n '^  Weekly disk cleanup - ' "$LOG_FILE" | tail -1 | cut -d: -f1)"
  if [ -z "$start" ]; then
    problem "no run found in $LOG_FILE"
  else
    tail -n "+$start" "$LOG_FILE" > "$RUN"
    ok "last run: $(sed -n '1s/^  Weekly disk cleanup - //p' "$RUN")"
  fi
  # The log is appended to at the end of every run, so its mtime is the last run.
  age_days=$(( ( $(date +%s) - $(stat -f %m "$LOG_FILE") ) / 86400 ))
  if [ "$age_days" -gt "$MAX_AGE_DAYS" ]; then
    problem "last run is $age_days days old (limit $MAX_AGE_DAYS): is the launchd job loaded? launchctl print gui/$(id -u)/com.pieterdejong.weeklycleanup"
  else
    ok "last run is $age_days day(s) old"
  fi
fi

if [ -s "$RUN" ]; then
  # Step headings, normalised to their name: "--- npx cache (…) ---" → "npx cache".
  norm() { sed -E 's/^--- //; s/( \(|:| ---).*//'; }
  missing=""
  if [ -r "$CLEANUP_SCRIPT" ]; then
    expected="$(grep -E '^echo "--- ' "$CLEANUP_SCRIPT" | sed -E 's/^echo "//; s/"$//' | norm)"
    seen="$(grep -E '^--- ' "$RUN" | norm)"
    n_steps=0
    while IFS= read -r step; do
      [ -n "$step" ] || continue
      n_steps=$((n_steps + 1))
      printf '%s\n' "$seen" | grep -qxF -- "$step" || missing="$missing${missing:+, }$step"
    done <<EOF
$expected
EOF
    if [ -n "$missing" ]; then problem "steps missing from the run: $missing"; else ok "all $n_steps steps ran"; fi
  else
    problem "cannot read $CLEANUP_SCRIPT to know its steps"
  fi

  errs="$(grep -nE 'command not found|Operation not permitted|Permission denied|no matches found|^lsof: |Error response from daemon|Cannot connect to the Docker daemon|colima start failed|colima stop failed|^(Error|ERROR|fatal):' "$RUN" | head -5)"
  if [ -n "$errs" ]; then
    problem "error lines in the run:"; printf '%s\n' "$errs" | sed 's/^/    /'
  else
    ok "no error lines"
  fi

  for want in '^Stale: [0-9]+$|npx summary' \
              '^Old files: [0-9]+ · folders in use: [0-9]+$|Library-caches summary' \
              '^Reclaimed: -?[0-9]+ MB$|Reclaimed line' \
              '^Done: |Done line'; do
    pat="${want%|*}"; label="${want##*|}"
    if grep -qE "$pat" "$RUN"; then ok "$label present"; else problem "$label missing"; fi
  done

  if grep -q '^Colima was stopped: started for the prune$' "$RUN"; then
    if grep -q '^Colima stopped again$' "$RUN"; then
      ok "Colima started for the prune and stopped again"
    else
      problem "Colima was started for the prune but not stopped again"
    fi
  fi
fi

if [ "$problems" = 0 ]; then echo "Self-check: OK"; else echo "Self-check: $problems problem(s)"; fi
[ "$problems" = 0 ]
