#!/usr/bin/env bash
#
# codex-agents-sync — build Codex's global AGENTS.md from the Claude instruction files.
#
#   codex-agents-sync            write ~/.codex/AGENTS.md (mode 600)
#   codex-agents-sync --check    exit 1 when the file is missing or differs from a fresh build
#   codex-agents-sync --print    print the build to stdout, write nothing
#
# Why: Codex looks for AGENTS.md from the git root down to the working directory, so
# inside a repo under ~/dev it never reads ~/dev/AGENTS.md, and it has no `@` imports.
# The one file it reads everywhere is ~/.codex/AGENTS.md. This script builds that file
# from the same three sources Claude Code loads (design-decisions.md D66):
#
#   claude/CLAUDE.md        this machine          (live copy: ~/.claude/CLAUDE.md)
#   claude/dev-CLAUDE.md    the ~/dev workspace   (live copy: ~/dev/CLAUDE.md)
#   the do-not-touch register in the private companion repo
#
# `@` import lines are dropped; the register is inlined instead. The output has no
# date in it, so --check is a byte comparison. It holds the private register, so it
# is written mode 600 and never belongs in a repo. Without the register (a machine
# with no private repo) the build says so and tells the reader to ask first.
#
# A hand-written AGENTS.md found on the first run is kept as AGENTS.md.bak-<date>.
# Re-run after editing any of the three sources; scripts/test-docs.py fails on drift.
#
# Env:  CODEX_HOME            where AGENTS.md goes        (default ~/.codex)
#       DEV_ROOT              the workspace               (default ~/dev)
#       CODEX_SYNC_GLOBAL     source 1                    (default <repo>/claude/CLAUDE.md)
#       CODEX_SYNC_DEV        source 2                    (default <repo>/claude/dev-CLAUDE.md)
#       CODEX_SYNC_REGISTER   source 3                    (default $DEV_ROOT/dotfiles/private/registers/do-not-touch.md)
#       CODEX_SYNC_MAX_BYTES  refuse a larger build       (default 32768, Codex's project_doc_max_bytes)
#
# Exit: 0 written or up to date · 1 drift (--check) or build too large · 2 usage or missing source
#
# Tested by scripts/test-codex-agents.sh.

set -u

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$BIN_DIR/.." && pwd)"
DEV_ROOT="${DEV_ROOT:-$HOME/dev}"
GLOBAL_SRC="${CODEX_SYNC_GLOBAL:-$REPO/claude/CLAUDE.md}"
DEV_SRC="${CODEX_SYNC_DEV:-$REPO/claude/dev-CLAUDE.md}"
REGISTER="${CODEX_SYNC_REGISTER:-$DEV_ROOT/dotfiles/private/registers/do-not-touch.md}"
OUT_DIR="${CODEX_HOME:-$HOME/.codex}"
OUT="$OUT_DIR/AGENTS.md"
MAX_BYTES="${CODEX_SYNC_MAX_BYTES:-32768}"
MARKER='<!-- Generated by dotfiles/bin/codex-agents-sync. Do not edit: change the sources and re-run. -->'

MODE="write"
for a in "$@"; do
  case "$a" in
    --check) MODE="check" ;;
    --print) MODE="print" ;;
    -h|--help) awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"; exit 0 ;;
    *) echo "codex-agents-sync: unknown argument: $a" >&2; exit 2 ;;
  esac
done

for f in "$GLOBAL_SRC" "$DEV_SRC"; do
  [ -f "$f" ] || { echo "codex-agents-sync: source not found: $f" >&2; exit 2; }
done

# An `@path` line is a Claude Code import. Codex would read it as text.
without_imports() { grep -v '^@' "$1"; }

# shellcheck disable=SC2016 # the backticks are markdown, printed as they are
build() {
  printf '%s\n\n' "$MARKER"
  printf '# AGENTS.md\n\n'
  printf 'Three parts, the same instructions Claude Code loads: this machine, the `~/dev` workspace,\n'
  printf 'and the do-not-touch register. Part 2 and part 3 apply to work under `~/dev`.\n'
  printf '\n---\n\n<!-- part 1: this machine (claude/CLAUDE.md) -->\n\n'
  without_imports "$GLOBAL_SRC"
  printf '\n---\n\n<!-- part 2: the ~/dev workspace (claude/dev-CLAUDE.md) -->\n\n'
  without_imports "$DEV_SRC"
  printf '\n---\n\n<!-- part 3: do-not-touch register -->\n\n'
  if [ -f "$REGISTER" ]; then
    without_imports "$REGISTER"
  else
    printf '# Do-not-touch register\n\n'
    printf 'The register was not found when this file was built. Ask before modifying any repo\n'
    printf 'under `projects/`.\n'
  fi
}

if [ "$MODE" = "print" ]; then
  build
  exit 0
fi

umask 077
TMP="$(mktemp "${TMPDIR:-/tmp}/codex-agents-sync.XXXXXX")" || exit 2
trap 'rm -f "$TMP"' EXIT
build > "$TMP"
size="$(wc -c < "$TMP" | tr -d ' ')"

if [ "$MODE" = "check" ]; then
  if [ ! -f "$OUT" ]; then
    echo "codex-agents-sync: $OUT is missing — run codex-agents-sync"; exit 1
  fi
  if cmp -s "$TMP" "$OUT"; then
    echo "codex-agents-sync: $OUT is up to date ($size bytes)"; exit 0
  fi
  echo "codex-agents-sync: $OUT differs from its sources — run codex-agents-sync"; exit 1
fi

if [ "$size" -gt "$MAX_BYTES" ]; then
  echo "codex-agents-sync: build is $size bytes, over the $MAX_BYTES byte limit Codex reads — nothing written" >&2
  exit 1
fi
[ -f "$REGISTER" ] || echo "codex-agents-sync: register not found ($REGISTER) — built with the ask-first notice" >&2

if [ -f "$OUT" ] && cmp -s "$TMP" "$OUT"; then
  chmod 600 "$OUT"
  echo "codex-agents-sync: $OUT is up to date ($size bytes)"
  exit 0
fi

mkdir -p "$OUT_DIR" || exit 2
if [ -f "$OUT" ] && [ "$(head -n 1 "$OUT")" != "$MARKER" ]; then
  bak="$OUT.bak-$(date +%Y%m%d)"
  if [ -e "$bak" ]; then
    echo "codex-agents-sync: $OUT is hand-written and $bak already exists — move one of them, nothing written" >&2
    exit 1
  fi
  cp -p "$OUT" "$bak" || exit 2
  echo "codex-agents-sync: kept the hand-written file as $bak"
fi
NEW="$OUT.new.$$"
if ! { cp "$TMP" "$NEW" && chmod 600 "$NEW" && mv -f "$NEW" "$OUT"; }; then
  rm -f "$NEW"
  echo "codex-agents-sync: could not write $OUT" >&2
  exit 2
fi
echo "codex-agents-sync: wrote $OUT ($size bytes)"
