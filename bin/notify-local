#!/usr/bin/env bash
#
# notify-local — show a macOS notification. Nothing leaves the Mac.
#
# Usage: notify-local TITLE MESSAGE
#
# The maintenance jobs (bin/weekly-disk-cleanup.sh, scripts/mac-maintenance.sh)
# call this at the end of every real run with their one-line verdict. The
# notification stays in Notification Center until dismissed; the full text is in
# each job's log. Title and message go to osascript as arguments, never spliced
# into AppleScript source, so quotes in a message cannot break or inject into it.
#
# Env:  NOTIFY_OSASCRIPT  the osascript binary (default: osascript; tests stub it)
#
# Exit: 0 shown (or no osascript: nothing to do), 2 bad usage. A notification
# that cannot be shown never fails the caller.

set -u

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0
fi
if [ $# -ne 2 ]; then
  echo "usage: notify-local TITLE MESSAGE" >&2; exit 2
fi

OSA="${NOTIFY_OSASCRIPT:-osascript}"
command -v "$OSA" >/dev/null 2>&1 || exit 0
"$OSA" -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' \
  "$1" "$2" >/dev/null 2>&1 || true
exit 0
