{
  "permissions": {
    "allow": [
      "Bash(sw_vers:*)",
      "Bash(uname:*)",
      "Bash(which:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(whoami:*)",
      "Bash(hostname:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(top:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(pip3 list:*)",
      "Bash(npm list:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dev/dotfiles/claude/hooks/guard-git-bypass.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dev/dotfiles/claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
