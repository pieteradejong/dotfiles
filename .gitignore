# ============================================
# PRIVATE COMPANION REPO - NEVER COMMIT
# ============================================
# private/ is a separate, private git repo cloned in place. It holds the
# registers, decisions and reports that name real repos and exposures. This
# rule is layer one; security/gate.sh and CI refuse it independently.
/private/

# ============================================
# SECRETS & CREDENTIALS - NEVER COMMIT
# ============================================

# Secret file patterns
*.secret
*.secret.*
*.secrets
.zshrc.secrets
.zshrc.local
*secret*
!*secret*.template
*.private
*.confidential
*.local
!*.local.template

# Environment files
.env*
!.env.template
!.env.example
.envrc
.direnv/

# Keys and certificates
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.gpg
*.asc

# SSH keys - CRITICAL
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.pub
known_hosts
authorized_keys

# Credential patterns
*password*
*token*
*credential*
*api_key*
*apikey*
*secret_key*
*access_key*
*auth.json
*.secrets.json
*.secrets.yaml
*.secrets.yml

# Cloud provider credentials
.aws/credentials
.boto
.s3cfg
gcloud/
.azure/
.config/gcloud/

# Package manager auth (may contain tokens)
.npmrc.local
.pypirc
.gem/credentials

# Database
*.sql
*.sqlite
*.db

# ============================================
# AUDIT OUTPUT - NAMES PRIVATE PATHS AND FINDINGS
# ============================================
# dev-audit.sh writes findings outside this repo by default (~/dev/audit-reports/)
# and refuses to write into any git repo. These rules are the second layer, in
# case a report is ever produced in here by hand or with --out .
reports/
audit-reports/
*.report.md
findings-*.tsv
audit-????-??-??.md

# Security review write-ups: they quote the real host, account and email
# verbatim, which is exactly what this public repo must not carry.
security-review-*.md
docs/security-review-*.md

# ============================================
# SHELL HISTORY - CONTAINS TYPED COMMANDS
# ============================================

.bash_history
.zsh_history
.sh_history
.node_repl_history
.python_history
.irb_history
.psql_history
.mysql_history
.rediscli_history
.lesshst
.wget-hsts

# ============================================
# macOS
# ============================================

.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ============================================
# Windows
# ============================================

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ============================================
# Linux
# ============================================

*~
.directory
.Trash-*

# ============================================
# EDITORS & IDEs
# ============================================

# VSCode
.vscode/
!.vscode.config.md

# JetBrains
.idea/
*.iml

# Vim/Neovim
*.swp
*.swo
*.swn
.netrwhist
Session.vim
.vim/undodir/

# Emacs
*~
\#*\#
.#*
*.elc

# Sublime
*.sublime-workspace
*.sublime-project

# ============================================
# BACKUP & TEMPORARY FILES
# ============================================

*.backup
*.bak
*.orig
*.old
*.tmp
*.temp
.cache/
cache/
*.log
logs/

# ============================================
# OPTIONAL: UNCOMMENT IF NEEDED
# ============================================

# Homebrew Brewfile.lock (if you want reproducible installs, keep it)
# Brewfile.lock.json

# Node modules (shouldn't be in dotfiles, but just in case)
# node_modules/

# Python
# __pycache__/
# *.pyc
# .venv/
