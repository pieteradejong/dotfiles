<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.pieterdejong.weeklycleanup</string>
	<key>ProgramArguments</key>
	<array>
		<string>$HOME/dev/dotfiles/bin/weekly-disk-cleanup.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>$HOME/.weekly-disk-cleanup.launchd.log</string>
	<key>StandardOutPath</key>
	<string>$HOME/.weekly-disk-cleanup.launchd.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
		<key>Weekday</key>
		<integer>0</integer>
	</dict>
</dict>
</plist>
